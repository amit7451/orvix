# ORVIX environment configuration
# Copy this file to `.env` and adjust as needed. Nothing here is a real secret.

# --- Identity / environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
# Local dev default (zero setup, file-based):
DATABASE_URL=sqlite+aiosqlite:///./orvix.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://orvix:orvix@localhost:5432/orvix

# --- LLM provider ---
# mock = fully offline, deterministic, zero external calls (default, used for the demo)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- RAG / vector store ---
VECTOR_STORE=memory
EMBEDDING_DIM=256
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true

# --- Notifications ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=

# --- Safety / automation ---
ENABLE_AUTO_REMEDIATION=true
DRY_RUN=false
APPROVAL_TIMEOUT_SECONDS=900

# --- Security ---
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
